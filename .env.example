# 复制为 .env 后按需修改；请勿提交真实密钥
# 用法：cp .env.example .env && set -a; source .env; set +a

# 1 = 开发模式（DEBUG 开启）；0 = 生产模式（必须提供 SECRET_KEY）
DJANGO_DEBUG=1

# 生产模式必填，开发模式可留空
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=

# 允许访问的域名，逗号分隔
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 反向代理/隧道域名，例如 https://cost.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------- 数据库
# 默认 SQLite；设置 DB_ENGINE=mysql 切换到 MySQL
# DB_ENGINE=mysql
DB_ENGINE=

# SQLite 文件路径（可选，默认项目根目录 db.sqlite3）
DJANGO_DB_PATH=

# MySQL 连接信息（DB_ENGINE=mysql 时生效）
DB_NAME=cost_verification
DB_USER=cost
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
