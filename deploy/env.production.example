# 复制为 deploy/env.production 后填写；不要提交真实密钥
DJANGO_DEBUG=0
# 用 python3 -c "import secrets; print(secrets.token_urlsafe(48))" 生成
DJANGO_SECRET_KEY='请替换为随机密钥'
DJANGO_ALLOWED_HOSTS='cost.example.com'
DJANGO_CSRF_TRUSTED_ORIGINS='https://cost.example.com'
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
DJANGO_DB_PATH='/opt/cost_system/db.sqlite3'
PYTHONUNBUFFERED=1
