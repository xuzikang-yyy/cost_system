[Unit]
Description=采购成本核价系统 (gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/cost_system
EnvironmentFile=/opt/cost_system/deploy/env.production
Environment=PYTHONPATH=/opt/cost_system/.vendor
ExecStartPre=/usr/bin/python3 /opt/cost_system/manage.py migrate --noinput
ExecStartPre=/usr/bin/python3 /opt/cost_system/manage.py collectstatic --noinput
ExecStart=/usr/bin/python3 -m gunicorn config.wsgi:application -c /opt/cost_system/deploy/gunicorn.conf.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
